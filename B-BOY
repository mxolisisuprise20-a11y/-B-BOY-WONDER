const { default: makeWASocket, useMultiFileAuthState } = require('@whiskeysockets/baileys')
const P = require('pino')

async function startBot() {
  const { state, saveCreds } = await useMultiFileAuthState('./session')
  const sock = makeWASocket({
    logger: P({ level: 'silent' }),
    auth: state,
    browser: ["B-BOY-WONDER", "Chrome", "1.0"]
  })

  sock.ev.on('creds.update', saveCreds)
  sock.ev.on('connection.update', (u) => {
    if(u.connection === 'open') console.log('B-BOY-WONDER ONLINE!')
  })

  sock.ev.on('messages.upsert', async (m) => {
    const msg = m.messages[0]
    if(!msg.message) return
    const text = msg.message.conversation || msg.message.extendedTextMessage?.text || ""
    const from = msg.key.remoteJid

    if(text === '.ping') {
      await sock.sendMessage(from, { text: `⚡ *B-BOY-WONDER Ping* 📡\n\n0.0025 ms\n\nOnline ✅` })
    }
    if(text === '.menu') {
      await sock.sendMessage(from, { text: `*B-BOY-WONDER MENU* 🕺\n\n⚡.ping\n📜.menu\n🔥.alive` })
    }
  })
}
startBot()
